// ─────────────────────────────────────────────────────────────────────
// SECTION 10: Anti-Cheat
// ─────────────────────────────────────────────────────────────────────

describe('Anti-Cheat', () => {
  beforeEach(() => {
    useGameStore.setState(useGameStore.getInitialState());
  });

  describe('divergesFromExpected()', () => {
    it('returns false when money is within expected range', () => {
      useGameStore.setState({ money: 1000 });
      expect(getStore().divergesFromExpected(1100)).toBe(false);
    });

    it('returns false when serverComputedMax is 0 or negative', () => {
      expect(getStore().divergesFromExpected(0)).toBe(false);
      expect(getStore().divergesFromExpected(-1)).toBe(false);
    });

    it('returns true when money exceeds expected by >10%', () => {
      useGameStore.setState({ money: 2000 });
      expect(getStore().divergesFromExpected(1000)).toBe(true);
    });
  });
});

// ─────────────────────────────────────────────────────────────────────
// SECTION 11: Export/Import
// ─────────────────────────────────────────────────────────────────────

describe('Save Export/Import', () => {
  beforeEach(() => {
    useGameStore.setState(useGameStore.getInitialState());
  });

  describe('exportSave()', () => {
    it('returns a base64-encoded string', () => {
      const save = getStore().exportSave();
      expect(typeof save).toBe('string');
      expect(save.length).toBeGreaterThan(0);
    });

    it('produces valid base64', () => {
      const save = getStore().exportSave();
      expect(() => atob(save)).not.toThrow();
    });
  });

  describe('importSave()', () => {
    it('imports a valid save', () => {
      const save = getStore().exportSave();
      useGameStore.setState({ money: 999 }); // change state
      const result = getStore().importSave(save);
      expect(result).toBe(true);
      expect(getStore().money).toBe(1000); // back to original
    });

    it('rejects invalid save string', () => {
      expect(getStore().importSave('invalid!')).toBe(false);
    });

    it('rejects save with money exceeding MAX_MONEY', () => {
      const badState = JSON.stringify({ money: 1e13, gameTick: 0, resources: {}, buildings: [], _version: 20 });
      const encoded = btoa(encodeURIComponent(badState));
      expect(getStore().importSave(encoded)).toBe(false);
    });

    it('rejects save with negative money', () => {
      const badState = JSON.stringify({ money: -100, gameTick: 0, resources: {}, buildings: [], _version: 20 });
      const encoded = btoa(encodeURIComponent(badState));
      expect(getStore().importSave(encoded)).toBe(false);
    });

    it('rejects save with Infinity money', () => {
      const badState = JSON.stringify({ money: Infinity, gameTick: 0, resources: {}, buildings: [], _version: 20 });
      const encoded = btoa(encodeURIComponent(badState));
      expect(getStore().importSave(encoded)).toBe(false);
    });

    it('rejects save with too many buildings', () => {
      const buildings = Array(501).fill(null).map((_, i) => ({ id: `b${i}`, type: 'ironMine', level: 1, active: true, efficiency: 1, placedAt: 0 }));
      const badState = JSON.stringify({ money: 1000, gameTick: 0, resources: { iron: 0 }, buildings, _version: 20 });
      const encoded = btoa(encodeURIComponent(badState));
      expect(getStore().importSave(encoded)).toBe(false);
    });
  });

  describe('resetGame()', () => {
    it('resets to initial state', () => {
      getStore().togglePause(); // change state
      getStore().resetGame();
      expect(getStore().paused).toBe(false);
      expect(getStore().money).toBe(1000);
      expect(getStore().buildings).toEqual([]);
    });
  });
});

// ─────────────────────────────────────────────────────────────────────
// SECTION 12: Blueprint Actions
// ─────────────────────────────────────────────────────────────────────

describe('Blueprint Actions', () => {
  beforeEach(() => {
    useGameStore.setState(useGameStore.getInitialState());
  });

  describe('saveBlueprint() + deleteBlueprint()', () => {
    it('saves and deletes a blueprint', () => {
      getStore().saveBlueprint('Test Layout');
      expect(getStore().blueprints.length).toBe(1);
      expect(getStore().blueprints[0].name).toBe('Test Layout');
      
      getStore().deleteBlueprint(getStore().blueprints[0].id);
      expect(getStore().blueprints.length).toBe(0);
    });
  });

  describe('renameBlueprint()', () => {
    it('renames a blueprint', () => {
      getStore().saveBlueprint('Old Name');
      const id = getStore().blueprints[0].id;
      getStore().renameBlueprint(id, 'New Name');
      expect(getStore().blueprints[0].name).toBe('New Name');
    });
  });

  describe('exportBlueprint()', () => {
    it('exports a blueprint as base64 string', () => {
      getStore().saveBlueprint('Export Test');
      const code = getStore().exportBlueprint(getStore().blueprints[0].id);
      expect(typeof code).toBe('string');
      expect(code.length).toBeGreaterThan(0);
    });

    it('returns empty string for non-existent blueprint', () => {
      expect(getStore().exportBlueprint('nonexistent')).toBe('');
    });
  });

  describe('importBlueprint()', () => {
    it('imports a valid blueprint code', () => {
      // First export to get a valid code
      getStore().saveBlueprint('Original');
      const code = getStore().exportBlueprint(getStore().blueprints[0].id);
      
      // Import should work
      expect(getStore().importBlueprint(code)).toBe(true);
    });

    it('rejects invalid blueprint code', () => {
      expect(getStore().importBlueprint('invalid')).toBe(false);
    });

    it('rejects blueprint with too many buildings', () => {
      const badBp = { n: 'Huge', b: Array(501).fill({ t: 'ironMine', c: 1 }), t: [], v: 1 };
      const code = btoa(encodeURIComponent(JSON.stringify(badBp)));
      expect(getStore().importBlueprint(code)).toBe(false);
    });

    it('rejects blueprint with negative building count', () => {
      const badBp = { n: 'Bad', b: [{ t: 'ironMine', c: -1 }], t: [], v: 1 };
      const code = btoa(encodeURIComponent(JSON.stringify(badBp)));
      expect(getStore().importBlueprint(code)).toBe(false);
    });
  });
});

