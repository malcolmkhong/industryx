describe('Payout Actions', () => {
  beforeEach(() => {
    useGameStore.setState(useGameStore.getInitialState());
  });

  describe('toggleAutoCollect()', () => {
    it('toggles autoCollect', () => {
      const before = getStore().payoutConfig.autoCollect;
      getStore().toggleAutoCollect();
      expect(getStore().payoutConfig.autoCollect).toBe(!before);
    });
  });

  describe('collectPayout()', () => {
    it('collects pending payout', () => {
      useGameStore.setState({ pendingPayout: 500 });
      const moneyBefore = getStore().money;
      getStore().collectPayout();
      expect(getStore().money).toBe(moneyBefore + 500);
      expect(getStore().pendingPayout).toBe(0);
    });

    it('does nothing when no pending payout', () => {
      const moneyBefore = getStore().money;
      getStore().collectPayout();
      expect(getStore().money).toBe(moneyBefore);
    });
  });
});

