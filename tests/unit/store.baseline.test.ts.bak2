// ─────────────────────────────────────────────────────────────────────

describe('Storage Actions', () => {
  beforeEach(() => {
    useGameStore.setState(useGameStore.getInitialState());
  });

  describe('upgradeStorage()', () => {
    it('upgrades storage capacity for a resource', () => {
      const initialCap = getStore().resourceCapacity.iron;
      const initialLevel = getStore().storageUpgradeLevels.iron;
      getStore().upgradeStorage('iron', 1);
      expect(getStore().resourceCapacity.iron).toBeGreaterThan(initialCap);
      expect(getStore().storageUpgradeLevels.iron).toBe(initialLevel + 1);
    });

    it('does nothing when money is insufficient', () => {
      useGameStore.setState({ money: 0 });
      const initialCap = getStore().resourceCapacity.iron;
      getStore().upgradeStorage('iron', 1);
      expect(getStore().resourceCapacity.iron).toBe(initialCap);
    });
  });
});

