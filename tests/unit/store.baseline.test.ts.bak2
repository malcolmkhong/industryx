describe('Drone Actions', () => {
  beforeEach(() => {
    useGameStore.setState(useGameStore.getInitialState());
  });

  describe('buyDrone()', () => {
    it('buys a drone when enough money', () => {
      const moneyBefore = getStore().money;
      const fleetBefore = getStore().drones.fleet.length;
      getStore().buyDrone();
      expect(getStore().drones.fleet.length).toBe(fleetBefore + 1);
      expect(getStore().money).toBeLessThan(moneyBefore);
    });

    it('does not buy drone without enough money', () => {
      useGameStore.setState({ money: 0 });
      const fleetBefore = getStore().drones.fleet.length;
      getStore().buyDrone();
      expect(getStore().drones.fleet.length).toBe(fleetBefore);
    });
  });

  describe('generateDroneMissions()', () => {
    it('generates empty missions when only one building type', () => {
      useGameStore.setState({ buildings: [createMockBuilding('ironMine')] });
      const missions = getStore().generateDroneMissions();
      expect(Array.isArray(missions)).toBe(true);
    });
  });
});

