    expect(getStore().quests).toEqual([]);
    getStore().setTrackedQuest(null);
    expect(getStore().trackedQuest).toBeNull();
  });

  it('upgradeTransportLine does nothing for non-existent line', () => {
    getStore().upgradeTransportLine('nonexistent');
    expect(getStore().transportLines).toEqual([]);
  });

  it('toggleBuilding does nothing for non-existent building', async () => {
    await getStore().toggleBuilding('nonexistent');
