// ─────────────────────────────────────────────────────────────────────
// SECTION 20: gameTickAction (Core Tick)
// ─────────────────────────────────────────────────────────────────────

describe('gameTickAction()', () => {
  beforeEach(() => {
    useGameStore.setState(useGameStore.getInitialState());
    vi.clearAllMocks();
  });

  it('does nothing when paused', () => {
    useGameStore.setState({ paused: true });
    const tickBefore = getStore().gameTick;
    getStore().gameTickAction();
    expect(getStore().gameTick).toBe(tickBefore);
  });

  it('increments gameTick when not paused', () => {
    const tickBefore = getStore().gameTick;
    getStore().gameTickAction();
    expect(getStore().gameTick).toBe(tickBefore + 1);
  });

  it('updates playTime stat', () => {
    const playTimeBefore = getStore().stats.playTime;
    getStore().gameTickAction();
    expect(getStore().stats.playTime).toBe(playTimeBefore + 1);
  });

  it('keeps resources non-negative', () => {
    useGameStore.setState({ resources: { ...getStore().resources, iron: 0 } });
    getStore().gameTickAction();
    // No crash, resources remain >= 0
    expect(getStore().resources.iron).toBeGreaterThanOrEqual(0);
  });

  it('updates lastOnlineTimestamp', () => {
    const tsBefore = getStore().lastOnlineTimestamp;
    getStore().gameTickAction();
    expect(getStore().lastOnlineTimestamp).toBeGreaterThanOrEqual(tsBefore);
  });
});

