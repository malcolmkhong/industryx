describe('applyServerState()', () => {
  beforeEach(() => {
    useGameStore.setState(useGameStore.getInitialState());
  });

  it('replaces entire state and updates lastOnlineTimestamp', () => {
    const oldTs = getStore().lastOnlineTimestamp;
    const newState = {
      ...getStore(),
      money: 5000,
      gameTick: 100,
    };
    getStore().applyServerState(newState);
    expect(getStore().money).toBe(5000);
    expect(getStore().gameTick).toBe(100);
    expect(getStore().lastOnlineTimestamp).toBeGreaterThanOrEqual(oldTs);
  });
});

