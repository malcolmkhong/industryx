describe('LLM News Integration', () => {
  beforeEach(() => {
    useGameStore.setState(useGameStore.getInitialState());
  });

  it('getNewsLLMState returns the LLM engine state', () => {
    const state = getStore().getNewsLLMState();
    expect(state).toBeDefined();
    expect(typeof state).toBe('object');
  });

  it('refreshNewsFromLLM updates market news', () => {
    useGameStore.setState({ marketNews: [
      { id: 'news-1', title: 'Old', description: 'Old desc', affectedResources: ['iron'], textSource: 'fallback' as const, tick: 0 } as never,
    ]});
    getStore().refreshNewsFromLLM([{ id: 'news-1', title: 'New', description: 'New desc', affectedResources: ['copper'], textSource: 'llm' }]);
    expect(getStore().marketNews[0].title).toBe('New');
    expect(getStore().marketNews[0].textSource).toBe('llm');
  });
});

// ─────────────────────────────────────────────────────────────────────
// SECTION 25: Game Tick State Fields Update
// ─────────────────────────────────────────────────────────────────────

describe('Game Tick — State Field Updates', () => {
  beforeEach(() => {
    useGameStore.setState(useGameStore.getInitialState());
    vi.clearAllMocks();
  });

  it('preserves productionSnapshot after tick', () => {
    getStore().gameTickAction();
    const ps = getStore().productionSnapshot;
    expect(ps).toBeDefined();
    expect(typeof ps.powerProduction).toBe('number');
    expect(typeof ps.moneyIncomeRate).toBe('number');
  });

  it('updates weather when remaining expires', () => {
    useGameStore.setState({
      weather: { current: 'clear', intensity: 0, remaining: 0, nextChange: 0 },
    });
    getStore().gameTickAction();
    // Weather might change — just check no crash
    const w = getStore().weather;
    expect(['clear', 'rainy', 'stormy', 'sunny', 'foggy', 'snowy']).toContain(w.current);
  });

  it('processes contracts with timeRemaining', () => {
    useGameStore.setState({
      contracts: [{
        id: 'c-test', name: 'Test', type: 'supply', description: '',
        requiredResources: [], timeLimit: 10, timeRemaining: 5,
        reward: { money: 100, researchPoints: 0, corporationPoints: 0 },
        difficulty: 1, gameTier: 0,
        progress: 0, completed: false, failed: false, icon: '',
      }],
    });
    getStore().gameTickAction();
    expect(getStore().contracts[0].timeRemaining).toBe(4);
  });
});

