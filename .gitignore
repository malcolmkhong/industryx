# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# dev server logs
dev*.log

# local env files
.env*.local
.env

# vercel
.vercel
skills/**/*.generated
skills/**/*.cache
skills/tmp/
# supabase/ is gitignored (contains Supabase CLI config), but migrations/ is tracked
# Be specific about what to ignore rather than ignoring the whole folder,
# otherwise negation rules below the directory pattern are unreachable.
supabase/.env*
supabase/.gitignore
supabase/config.toml
supabase/.branches
supabase/.temp
supabase/.cache
supabase/.DS_Store
!supabase/migrations/
.omo/
*.dev.log

# typescript
*.tsbuildinfo
next-env.d.ts

# build/lint/tsc output captures (regenerated on demand)
build-output.txt
lint-output.txt
ts-output.txt

# dev server stderr/stdout redirects
dev-server.err
dev-server.out

# dead shell scripts (Linux paths, irrelevant on this Windows project)
start-dev.sh
keep-alive.sh

# vector store experiments (orphaned)
chroma/

# stale dated audit snapshots (move to planning/<date>_audit/ instead)
AUDIT_FIXES_*.md

# backup folders
Backup */

# uploaded/pasted images
upload/

# runtime files
*.pid
.zscripts/dev.pid

# database
*.db
db/

# allow tracked db/ helper modules under src/ (TypeScript, not sqlite)
!src/lib/db/
!src/lib/db/**

# agent context
agent-ctx/

# QA/downloaded screenshots
download/

# test/debug screenshots
test-screenshot*.png

# Mini services (backend merged into main project)
mini-services/

# Z scripts runtime logs
.zscripts/

# Keep-alive script
keep-alive.sh
keep-alive.log

# Server logs
server.log

# Editor history (Zed, VSCode, etc.)
.history/

# Development
bun.lock
Caddyfile
worklog.md

# Documentation
docs/

# AI tooling (machine-local, never push)
.agents/
.opencode/
.hermes/
.github/copilot-instructions.md
.vscode/mcp.json
.eslintcache

# User-installed skill marketplace (not project files)
skills/
skills-lock.json

# Local-only planning scratch + scratch tests
planning/archive/
planning/new/
tests/staging/

# Asset artifacts not for source control
public/ChatGPT Image*.png
