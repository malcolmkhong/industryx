# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# dev server logs
dev*.log

# local env files
.env*.local
.env

# vercel
.vercel
# build output preview
/html/
skills/**/*.generated
skills/**/*.cache
skills/tmp/
# supabase/ is gitignored (contains Supabase CLI config), but migrations/ is tracked
# Be specific about what to ignore rather than ignoring the whole folder,
# otherwise negation rules below the directory pattern are unreachable.
supabase/.env*
supabase/.gitignore
supabase/config.toml
supabase/.branches
supabase/.temp
supabase/.cache
supabase/.DS_Store

# DB dump files (one-off snapshots, not source of truth)
defs_*.json

# Test backup files (local-only)
*.bak
*.bak2
*.bak3
!supabase/migrations/
.omo/
*.dev.log

# typescript
*.tsbuildinfo
next-env.d.ts

# build/lint/tsc output captures (regenerated on demand)
build-output.txt
lint-output.txt
ts-output.txt

# dev server stderr/stdout redirects
dev-server.err
dev-server.out

# dead shell scripts (Linux paths, irrelevant on this Windows project)
start-dev.sh
keep-alive.sh

# vector store experiments (orphaned)
chroma/

# stale dated audit snapshots (move to planning/<date>_audit/ instead)
AUDIT_FIXES_*.md

# backup folders
Backup */

# uploaded/pasted images
upload/

# runtime files
*.pid
.zscripts/dev.pid

# database
*.db
db/

# allow tracked db/ helper modules under src/ (TypeScript, not sqlite)
!src/lib/db/
!src/lib/db/**

# agent context
agent-ctx/

# QA/downloaded screenshots
download/

# test/debug screenshots
test-screenshot*.png

# Mini services (backend merged into main project)
mini-services/

# Z scripts runtime logs
.zscripts/

# Keep-alive script
keep-alive.sh
keep-alive.log

# Server logs
server.log

# Editor history (Zed, VSCode, etc.)
.history/

# Development
bun.lock
Caddyfile
worklog.md

# Documentation
docs/

# AI tooling (machine-local, never push)
.agents/
.opencode/
.hermes/
.github/copilot-instructions.md
.vscode/mcp.json
.eslintcache

# User-installed skill marketplace (not project files)
skills/
skills-lock.json

script/

# Local-only planning scratch
planning/archive/
planning/new/

story-body.txt
IDEA.md

# Asset artifacts not for source control
public/ChatGPT Image*.png

# Tool binaries too large for GitHub
tools/

# Claude Code working directory
.claude/

# Codex history
.history/

# MCP tool config
.mcp.json

# Playwright test output
test-results/

# Playwright config
playwright.config.ts

# --------------------------------------------------------------------------
# One-off audit / debug scripts (regenerated on demand, not source of truth)
# Keep tests/runtime scripts; ignore ad-hoc DB probes.
# --------------------------------------------------------------------------
scripts/check-*.cjs
scripts/check-*.mjs
scripts/inventory-*.cjs
scripts/delete-*.cjs
scripts/fix-test-*.py
scripts/update-bugs-*.py

# Supabase REST dump artifacts (sandbox probing output)
sb_*.txt

# Single-temp handoff docs (regenerated by claude / claude-code session)
handoff-*.md

# Debug screenshots taken during refactor / QA (regenerated, not assets)
dashboard-*.png
factory-*.png
page-*.png
market-*.png
test-screenshot*.png
.playwright-mcp/

# Debug browser scripts / setGameSpeed exploration (pre-refactor scratch)
scripts/browser-*.js
scripts/test-setGameSpeed-*

# All planning/ docs are local-only. Per-user decision 2026-07-05: keep
# the project's audit history on disk but never push to source control.
# Use AGENTS.md for canonical rules; per-phase audit context lives in
# commit messages instead.
planning/

# All scripts/ are local-dev only. The scripts documented in commit
# messages serve as audit trail of what was tested, but the actual
# one-off .cjs/.mjs/.ts files are not for source control.
# Use tests/ + tests/integration/ for production test code.
scripts/
# Graphify self-output cache + cost (canonical artifacts tracked separately).
# Ignore the entire directory by default; per-file negations below restore
# the canonical human-readable artifacts (GRAPH_REPORT.md, graph.html,
# pipeline/learnings/, etc.) so cross-machine reuse stays possible.
graphify-out/
!graphify-out/GRAPH_REPORT.md
!graphify-out/graph.html
!graphify-out/manifest.json
!graphify-out/benchmark.json
!graphify-out/pipeline/
!graphify-out/obsidian/
# Re-ignore the heavy volatile subcache from the broad allow above.
graphify-out/cache/
graphify-out/cost.json
graphify-out/pipeline/.graphify_*.json

# Next.js dev restart loop log (Next 16 diagnostic spam)
.next-dev-restart.log

# Playwright debug probes
playwright-err.txt
playwright-out.txt

# Local build / typecheck / lint cache
.cache/

# Local log / probe debris
dev-server.err.log
dev-server.log
dev-stderr.log
dev-stdout.log
dev.log
diffstat.out
.lint.out
.tscheck*.out
**/tscheck*.out
**/vitest*.out

# Test backup fragments
*.bak2
*.bak3
.env.*
*.env
credentials.json
*.key
.credentials
