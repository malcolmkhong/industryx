# ============================================
# Supabase (client-safe public keys + server-only secrets)
# ============================================
# Public keys (NEXT_PUBLIC_*) — bundled into client JS, safe by design
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets — NEVER use NEXT_PUBLIC_ prefix for these
# Service role bypasses RLS — leaking = full database compromise
SUPABASE_SERVICE_ROLE_KEY=

# JWT verification (server-only — used to verify session tokens)
SUPABASE_JWT_SECRET=
SUPABASE_SECRET_KEY=

# Optional — explicit JWKS endpoint for asymmetric JWT verification
SUPABASE_JWKS_URL=

# Supabase dashboard API access (server-only)
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=

# ============================================
# Database (server-only connection strings)
# ============================================
# Direct Postgres connection (used by Supabase clients)
DATABASE_URL=
POSTGRES_DATABASE=
POSTGRES_HOST=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_PRISMA_URL=

# ============================================
# Admin
# ============================================
# Comma-separated list of Supabase user IDs granted super_admin on first boot
ADMIN_UIDS=

# ============================================
# Game secrets (server-only — rotate via secrets management)
# ============================================
# Used for state checksum / anti-cheat
CHECKSUM_SECRET=

# Used to authenticate cron job requests
CRON_SECRET=

# ============================================
# Cloudflare Workers (server-only)
# ============================================
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_WORKER_URL=
MARKET_NEWS_WORKER_URL=

# ============================================
# AI Providers (server-only)
# ============================================
OPENCODE_API_KEY=
GROQ_API_KEY=

# ============================================
# GitHub
# ============================================
GITHUB_TOKEN=

# ============================================
# Sentry (NEXT_PUBLIC_* = safe for client; rest = server-only)
# ============================================
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
