{
  "$schema": "node_modules/wrangler/config-schema.json",
  // This file prevents wrangler's auto-detection from running the
  // @opennextjs/cloudflare pipeline on the repo root.
  //
  // The repo root is a Next.js app (deployed on Vercel), NOT a
  // Cloudflare Workers project. The Cloudflare GitHub App auto-detects
  // this repo as Next.js and fires a "Workers Builds" check that
  // fails because the OpenNext pipeline doesn't support Node.js
  // middleware (src/proxy.ts).
  //
  // The App's deploy command is: npm run build && npx wrangler deploy
  // We can't change npm run build (Next.js), but we CAN configure
  // wrangler so it skips the OpenNext pipeline during `wrangler deploy`.
  //
  // Key insight: providing an explicit `build.command` in wrangler.jsonc
  // tells wrangler to use that build step instead of the OpenNext
  // pipeline. A no-op echo command prevents OpenNext from running.
  //
  // The newsgenerator worker is deployed MANUALLY from
  // cloudflare/newsgenerator/ via its own wrangler.toml. This root
  // wrangler.jsonc only exists to suppress the failing OpenNext
  // pipeline that the Cloudflare GitHub App triggers on every push.

  "compatibility_date": "2026-06-23",

  // Override the build step. This is the critical line — it replaces
  // the OpenNext build (which fails on Node.js middleware) with a
  // no-op. Wrangler will skip the OpenNext pipeline entirely.
  "build": {
    "command": "echo 'wrangler root: skipping opennextjs-cloudflare — workers deployed manually from cloudflare/*/wrangler.toml'"
  }
}
