{
  "name": "nextjs_tailwind_shadcn_ts",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build --turbopack",
    "start": "NODE_ENV=production bun .next/standalone/server.js 2>&1 | tee server.log",
    "lint": "eslint . --cache --cache-location .cache/eslint",
    "test": "tsx --test --test-reporter=spec tests/integration/*.test.ts tests/security/*.test.ts",
    "test:vitest": "vitest run --reporter=verbose",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/unit",
    "test:components": "vitest run tests/components",
    "test:db": "vitest run tests/db",
    "test:workflow": "vitest run tests/workflow",
    "test:performance": "vitest run tests/performance",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "test:security": "tsx --test tests/security/*.test.ts",
    "test:all": "npm run test && npm run test:vitest",
    "typecheck": "tsc --noEmit"
  },
